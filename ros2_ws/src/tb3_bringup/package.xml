<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tb3_bringup</name>
  <version>0.1.0</version>
  <description>
    Punto de entrada principal del sistema TurtleBot3.
    Orquesta Gazebo Sim, robot_state_publisher, ros_gz_bridge y RViz2.
    Contiene launch files, mundos SDF y configuraciones globales.
  </description>
  <maintainer email="juankibenitez57@gmail.com">juanks</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>tb3_description</depend>
  <depend>nav2_minimal_tb3_sim</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>rviz2</depend>
  <depend>xacro</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
