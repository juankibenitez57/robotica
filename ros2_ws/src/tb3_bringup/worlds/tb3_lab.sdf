<?xml version="1.0" ?>
<!--
  Mundo de pruebas TB3 — Campo de fútbol simplificado
  Contiene: porterías, balón, paredes, cajas y cilindros
-->
<sdf version="1.6">
  <world name="tb3_lab">

    <!-- Física -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins obligatorios -->
    <plugin filename="gz-sim-physics-system"       name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"       name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"       name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
      <headless_rendering>true</headless_rendering>
    </plugin>
    <plugin filename="gz-sim-imu-system"           name="gz::sim::systems::Imu"/>
    <!-- Luz -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ═══════════════════════════════════════════════════
         SUELO
    ═══════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.3 0.6 0.3 1</ambient>
            <diffuse>0.3 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         PORTERÍA NORTE (y = +7)
    ═══════════════════════════════════════════════════ -->
    <model name="goal_north">
      <static>true</static>
      <pose>0 7 0 0 0 0</pose>
      <!-- Poste izquierdo -->
      <link name="post_left">
        <pose>-1.5 0 0.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.08 0.08 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.08 0.08 1.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <!-- Poste derecho -->
      <link name="post_right">
        <pose>1.5 0 0.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.08 0.08 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.08 0.08 1.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <!-- Larguero -->
      <link name="crossbar">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.08 0.08 0.08</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.08 0.08 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         PORTERÍA SUR (y = -7)
    ═══════════════════════════════════════════════════ -->
    <model name="goal_south">
      <static>true</static>
      <pose>0 -7 0 0 0 0</pose>
      <link name="post_left">
        <pose>-1.5 0 0.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.08 0.08 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.08 0.08 1.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="post_right">
        <pose>1.5 0 0.75 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.08 0.08 1.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.08 0.08 1.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <link name="crossbar">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="col"><geometry><box><size>3.08 0.08 0.08</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>3.08 0.08 0.08</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         BALÓN (empujable)
    ═══════════════════════════════════════════════════ -->
    <model name="ball">
      <pose>0 0 0.11 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.45</mass>
          <inertia><ixx>0.0018</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0018</iyy><iyz>0</iyz><izz>0.0018</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><sphere><radius>0.11</radius></sphere></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="vis">
          <geometry><sphere><radius>0.11</radius></sphere></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         PAREDES LATERALES
    ═══════════════════════════════════════════════════ -->
    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.7 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.7 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         CAJAS (empujables) — dispersas por el campo
    ═══════════════════════════════════════════════════ -->
    <model name="box_1">
      <pose>3 3 0.15 0 0 0.3</pose>
      <link name="link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.0083</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0083</iyy><iyz>0</iyz><izz>0.0083</izz></inertia>
        </inertial>
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <pose>-3 -3 0.15 0 0 0.8</pose>
      <link name="link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.0083</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0083</iyy><iyz>0</iyz><izz>0.0083</izz></inertia>
        </inertial>
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient><diffuse>0.2 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_3">
      <pose>4 -2 0.15 0 0 1.2</pose>
      <link name="link">
        <inertial><mass>1.0</mass>
          <inertia><ixx>0.0083</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0083</iyy><iyz>0</iyz><izz>0.0083</izz></inertia>
        </inertial>
        <collision name="col"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.3 0.3 0.3</size></box></geometry>
          <material><ambient>0.8 0.8 0.2 1</ambient><diffuse>0.8 0.8 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         OBJETOS DETECTABLES POR YOLO — Fase 5
         kitchen:     Mustard Bottle (YCB) — texturas reales, YOLO detecta 'bottle'
         living_room: botella primitiva  — respaldo garantizado
    ═══════════════════════════════════════════════════ -->

    <!-- Mustard Bottle (YCB dataset) — Fuel/Gambit — modelo con textura fotorrealista
         Cacheado en ~/.gz/fuel/ — Gazebo lo carga sin internet
         Waypoint kitchen: x=-2.97, y=-0.79, yaw=0 (robot mira +x)
         Botella a ~75 cm delante del robot al llegar a kitchen -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/Gambit/models/Mustard%20Bottle</uri>
      <name>mustard_bottle_kitchen</name>
      <pose>-2.2 -0.79 0 0 0 0</pose>
    </include>

    <!-- Botella primitiva — living_room (frente al waypoint x=-2.0, y=1.5, yaw=0)
         Radio 3.5 cm, altura 27 cm, color azul-translúcido
         Respaldo si el modelo Fuel no carga; también sirve para pruebas adicionales -->
    <model name="bottle_living_room">
      <static>true</static>
      <pose>-1.3 1.5 0 0 0 0</pose>
      <link name="link">
        <!-- Cuerpo -->
        <visual name="body">
          <pose>0 0 0.11 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.8 1.0 0.85</ambient>
            <diffuse>0.3 0.65 1.0 0.80</diffuse>
            <specular>0.9 0.95 1.0 1.0</specular>
          </material>
        </visual>
        <!-- Cuello -->
        <visual name="neck">
          <pose>0 0 0.245 0 0 0</pose>
          <geometry><cylinder><radius>0.018</radius><length>0.05</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.8 1.0 0.85</ambient>
            <diffuse>0.3 0.65 1.0 0.80</diffuse>
            <specular>0.9 0.95 1.0 1.0</specular>
          </material>
        </visual>
        <!-- Tapón (azul oscuro) -->
        <visual name="cap">
          <pose>0 0 0.278 0 0 0</pose>
          <geometry><cylinder><radius>0.022</radius><length>0.016</length></cylinder></geometry>
          <material>
            <ambient>0.05 0.2 0.7 1.0</ambient>
            <diffuse>0.05 0.2 0.7 1.0</diffuse>
            <specular>0.4 0.4 0.7 1.0</specular>
          </material>
        </visual>
        <!-- Colisión unificada -->
        <collision name="col">
          <pose>0 0 0.137 0 0 0</pose>
          <geometry><cylinder><radius>0.035</radius><length>0.274</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         CILINDROS (empujables) — dispersos por el campo
    ═══════════════════════════════════════════════════ -->
    <model name="cylinder_1">
      <pose>-4 3 0.2 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.8</mass>
          <inertia><ixx>0.0058</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0058</iyy><iyz>0</iyz><izz>0.002</izz></inertia>
        </inertial>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.0 1</ambient><diffuse>0.8 0.4 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_2">
      <pose>2 -4 0.2 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.8</mass>
          <inertia><ixx>0.0058</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0058</iyy><iyz>0</iyz><izz>0.002</izz></inertia>
        </inertial>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.5 0.0 0.8 1</ambient><diffuse>0.5 0.0 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_3">
      <pose>-2 5 0.2 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.8</mass>
          <inertia><ixx>0.0058</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0058</iyy><iyz>0</iyz><izz>0.002</izz></inertia>
        </inertial>
        <collision name="col"><geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry></collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
          <material><ambient>0.0 0.7 0.7 1</ambient><diffuse>0.0 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
